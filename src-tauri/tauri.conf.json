{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteGo",
  "version": "0.1.0",
  "identifier": "com.notego.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NoteGo",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "category": "Productivity",
    "shortDescription": "本地优先的 Markdown 知识库",
    "longDescription": "NoteGo 是一款类 Obsidian 的本地优先 Markdown 笔记软件，支持双向链接、知识图谱、S3 同步与全文搜索。"
  }
}
